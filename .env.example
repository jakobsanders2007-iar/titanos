# ---------------------------------------------------------------------------
# Titan Intelligence OS — environment variables
# Copy this file to `.env.local` and fill in the values you have.
# NEVER commit `.env.local`. Only this `.env.example` (with empty values)
# belongs in git.
#
# Every integration degrades gracefully: if a key is missing, that tool runs
# in MOCK mode and returns realistic normalized data so the product still works
# end-to-end for demos. Nothing crashes when a key is absent.
# ---------------------------------------------------------------------------

# --- Supabase (database + auth) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web crawling & extraction --------------------------------------------
FIRECRAWL_API_KEY=

# --- Browser automation ----------------------------------------------------
BROWSERBASE_API_KEY=

# --- Audio / call transcription -------------------------------------------
GLADIA_API_KEY=

# --- Generic / future integrations (product APIs vary) --------------------
GINA_API_KEY=
ATLAS_API_KEY=

# --- Telephony & SMS -------------------------------------------------------
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=

# --- Voice AI agents -------------------------------------------------------
VAPI_API_KEY=

# --- Web search / research -------------------------------------------------
EXA_API_KEY=

# --- Address validation ----------------------------------------------------
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# --- Banking / payments infrastructure (READ-ONLY placeholder) ------------
# Titan never moves money. These are for connection status only.
INCREASE_API_KEY=

# --- Transactional email ---------------------------------------------------
RESEND_API_KEY=

# --- Data validation & enrichment -----------------------------------------
ABSTRACT_API_KEY=

# --- Azure OpenAI (primary LLM reasoning) ---------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# --- Grok (alternative LLM reasoning) -------------------------------------
GROK_API_KEY=
GROK_BASE_URL=

# --- Agent behavior --------------------------------------------------------
# Optional: force all integrations into mock mode even when keys exist.
TITAN_FORCE_MOCK=
